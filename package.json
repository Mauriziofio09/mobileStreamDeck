{
  "name": "copper-deck",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "shared",
    "web",
    "helper"
  ],
  "scripts": {
    "build": "npm run build -w web && npm run build -w helper",
    "test": "npm run typecheck -w helper && npm test -w helper",
    "helper": "helper/bin/copper-deck serve",
    "screenshots": "node tools/screenshots.mjs",
    "compare": "node tools/compare.mjs",
    "e2e": "node tools/e2e-m2.mjs && node tools/e2e-m2-offline.mjs /tmp/copper-deck-e2e-helper.log",
    "install-agent": "scripts/install.sh",
    "e2e:launchd": "node tools/e2e-m3.mjs basic && node tools/e2e-m3-perms.mjs",
    "e2e:sync": "node tools/e2e-m4.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "sharp": "^0.34.0"
  }
}
