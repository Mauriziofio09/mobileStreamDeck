{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/fonts/*.woff2",
          "/icons/icon-512.png",
          "/icons/favicon-*.png"
        ]
      }
    },
    {
      "name": "icons-splash",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/icons/**",
          "/splash/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/ws",
    "!/**/*.*"
  ]
}
